<Window x:Class="LyricsOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrics Overlay — Settings"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="22,2,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,16,22,18">
        <TextBlock Text="Now playing" Style="{StaticResource Section}" Margin="0,0,0,6" />
        <TextBlock x:Name="NowPlayingText" TextWrapping="Wrap" />
        <TextBlock x:Name="LyricsSourceText" Style="{StaticResource Hint}" Margin="0,2,0,0" />

        <TextBlock Text="Where lyrics come from" Style="{StaticResource Section}" />
        <TextBlock TextWrapping="Wrap"
                   Text="Lyrics shown by the music player itself (YouTube Music) are always used first. Reading them needs the Lyrics Overlay Bridge browser extension." />
        <TextBlock x:Name="ExtensionStatusText" Margin="0,6,0,8" FontWeight="SemiBold" TextWrapping="Wrap" />

        <CheckBox x:Name="AllowExternalBox" Content="Allow external lyrics from LRCLIB.net" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="When the player has no lyrics, the song's title, artist, album and length are sent to lrclib.net to look them up. Stays off until you turn it on." />
        <CheckBox x:Name="PreferSyncedBox" Margin="22,0,0,4"
                  Content="Prefer LRCLIB's time-synced lyrics over the player's plain lyrics" />
        <CheckBox x:Name="BrowsersOnlyBox" Content="Only follow music playing in a web browser" />

        <TextBlock Text="Overlay" Style="{StaticResource Section}" />
        <CheckBox x:Name="ShowOverlayBox" Content="Show lyrics on screen" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Text size" VerticalAlignment="Center" />
            <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="16" Maximum="96" SmallChange="1" LargeChange="4"
                    VerticalAlignment="Center" Margin="0,4" />
            <TextBlock x:Name="FontSizeValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
            <TextBlock Grid.Row="1" Text="Opacity" VerticalAlignment="Center" />
            <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="1" SmallChange="0.05"
                    LargeChange="0.1" VerticalAlignment="Center" Margin="0,4" />
            <TextBlock x:Name="OpacityValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
        </Grid>
        <Button x:Name="EditOverlayButton" Content="Move or resize the overlay" HorizontalAlignment="Left"
                Padding="12,5" Margin="0,10,0,0" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                   Text="The overlay ignores your mouse and never takes focus, except while you're moving it." />

        <TextBlock Text="General" Style="{StaticResource Section}" />
        <CheckBox x:Name="StartupBox" Content="Start Lyrics Overlay when I sign in to Windows" />

        <DockPanel Margin="0,20,0,0">
            <Button x:Name="CloseButton" Content="Close" DockPanel.Dock="Right" Padding="18,5" IsDefault="True" IsCancel="True" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,12,0" VerticalAlignment="Center"
                       Text="Closing this window keeps Lyrics Overlay running in the system tray." />
        </DockPanel>
    </StackPanel>
</Window>
