<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 2004 target pulls in the WinRT projection for Windows.Media.Control (media sessions). -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF + WinForms implicit usings collide (Application, MessageBox, Color...), so usings are explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LyricsOverlay</AssemblyName>
    <RootNamespace>LyricsOverlay</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
